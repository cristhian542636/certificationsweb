# URL pública del sitio (sin "/" al final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡Secreta! Solo en el servidor. Nunca la expongas con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago → Tus integraciones → Credenciales (usa las de prueba para empezar)
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Mercado Pago → Tus integraciones → Webhooks → Clave secreta
MP_WEBHOOK_SECRET=

# Correos con acceso a /admin, separados por comas
ADMIN_EMAILS=
